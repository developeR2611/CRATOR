# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MOVIEBOX_API_URL: Cloudflare Worker base URL for MovieBox API
MOVIEBOX_API_URL="https://spun-moviebox.ravi-crator.workers.dev"

# MOVIEBOX_SECRET: Worker Secret for X-Worker-Secret header (SERVER-SIDE ONLY)
MOVIEBOX_SECRET=""

# TMDB_API_KEY: The Movie Database API Key v3 or v4 Read Access Token (SERVER-SIDE ONLY)
TMDB_API_KEY=""

# Supabase integration (optional client-side credentials)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
