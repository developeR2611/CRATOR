# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TMDB_API_KEY: The Movie Database API Key v3 or v4 Read Access Token (SERVER-SIDE ONLY)
# Used for live title discovery, trending, search, genres, posters, and cast.
TMDB_API_KEY=""

# Supabase integration (optional client-side persistence)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# NOTE: VidRift streaming requires NO API key or account credentials.
# Embeds are generated directly using TMDB/AniList IDs via https://embed.vidrift.net

# ==============================================================================
# CRATOR Download Manager (Server-Side Only — NEVER expose secrets to frontend)
# ==============================================================================
# Directory on persistent disk for downloaded media & atomic job state JSON
DOWNLOAD_STORAGE_DIR="/tmp/crator-downloads"
DOWNLOAD_STATE_FILE="/tmp/crator-downloads/state.json"

# Queue & quota controls
DOWNLOAD_MAX_CONCURRENCY="3"
DOWNLOAD_MAX_FILE_SIZE_BYTES="10737418240"
DOWNLOAD_MAX_STORAGE_BYTES="53687091200"
DOWNLOAD_RETENTION_HOURS="72"

# Comma-separated allowlist of authorized media hosts (supports *.domain.tld)
DOWNLOAD_ALLOWED_HOSTS="media.w3.org,archive.org,*.archive.org,download.blender.org,commondatastorage.googleapis.com"

# Optional custom authorized download catalog (JSON file path or inline JSON array)
DOWNLOAD_CATALOG_PATH=""
DOWNLOAD_AUTHORIZED_CATALOG_JSON=""

# aria2 JSON-RPC 2.0 backend (optional primary engine; falls back to resumable HTTP if unset)
ARIA2_RPC_URL="http://127.0.0.1:6800/jsonrpc"
ARIA2_RPC_SECRET=""
ARIA2_SPLIT="4"
ARIA2_MAX_CONN_PER_SERVER="4"

# FFmpeg / FFprobe post-download validation & stream-copy remuxing
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"
ENABLE_FFMPEG_VALIDATION="true"

# Signed session token HMAC secret for download API authentication
DOWNLOAD_AUTH_SECRET=""

# Optional: When frontend runs on Vercel Serverless, proxy /api/downloads/* to a dedicated persistent download service
DOWNLOAD_SERVICE_URL=""
DOWNLOAD_SERVICE_API_KEY=""

