# ==============================================================================
# CRATOR — Dedicated Persistent Download Service Container
# Includes Node.js 22, aria2, and FFmpeg for persistent disk downloads.
# ==============================================================================
FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    aria2 \
    ffmpeg \
    ca-certificates \
    curl \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci --include=dev

COPY . .
RUN npm run build

RUN mkdir -p /data/downloads && chown -R node:node /data/downloads /app

ENV NODE_ENV=production
ENV PORT=3000
ENV DOWNLOAD_STORAGE_DIR=/data/downloads
ENV FFMPEG_PATH=/usr/bin/ffmpeg
ENV FFPROBE_PATH=/usr/bin/ffprobe

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -fsS http://127.0.0.1:3000/api/downloads/health || exit 1

USER node
CMD ["npx", "tsx", "server.ts"]
